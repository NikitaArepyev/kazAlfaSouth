# Аналитика (необязательно). Если не заданы — скрипты не подключаются.
# Google Analytics 4 — измерение ID, например G-XXXXXXX
NEXT_PUBLIC_GA_ID=
# Яндекс Метрика — числовой счётчик, например 12345678
NEXT_PUBLIC_YM_ID=

# Доступ к админ-панели CMS (/admin)
# Секрет сессии (любая длинная строка). Обязательно задайте уникальное значение.
AUTH_SECRET=change-me-to-a-long-random-string
# Пароль администратора (полный доступ)
ADMIN_PASSWORD=change-me
# Пароль редактора (только контент, без заявок и настроек) — необязательно
ADMIN_EDITOR_PASSWORD=

# Уведомления о заявках с формы.
# Диск на хостинге эфемерный: если ни один канал не настроен, заявки видны
# только в /admin/leads и пропадают при следующем деплое.

# Telegram: создайте бота у @BotFather, получите токен.
# Chat id — свой id у @userinfobot, либо id группы (начинается с минуса).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта по SMTP. Для Gmail: включите двухфакторную защиту и создайте
# пароль приложения (App password) — обычный пароль от почты не подойдёт.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Куда слать заявки. Если пусто — на адрес из SMTP_USER.
MAIL_TO=

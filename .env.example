# Аналитика (необязательно). Если не заданы — скрипты не подключаются.
# Google Analytics 4 — измерение ID, например G-XXXXXXX
NEXT_PUBLIC_GA_ID=
# Яндекс Метрика — числовой счётчик, например 12345678
NEXT_PUBLIC_YM_ID=

# Доступ к админ-панели CMS (/admin)
# Секрет сессии (любая длинная строка). Обязательно задайте уникальное значение.
AUTH_SECRET=change-me-to-a-long-random-string
# Пароль администратора (полный доступ)
ADMIN_PASSWORD=change-me
# Пароль редактора (только контент, без заявок и настроек) — необязательно
ADMIN_EDITOR_PASSWORD=
